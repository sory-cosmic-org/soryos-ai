# Copy this file to `.env` and fill in the keys you have.
# The assistant always starts, even with no keys set (demo MockProvider).

# OpenRouter (https://openrouter.ai) — default model is the auto-router;
# the GUI lists every free (:free) model live from the catalogue.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Local OpenAI-compatible server (Ollama, llama.cpp, vLLM, ...)
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_MODEL=qwen2.5:7b
# LOCAL_AI_API_KEY=

# Default selection (provider names: openrouter, mistral, gemini, local, mock)
# SORYOS_PROVIDER=openrouter
# SORYOS_MODEL=
